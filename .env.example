# 必填：通义千问 / DashScope API Key。
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# DashScope OpenAI-compatible API。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_DIMENSIONS=1024
QWEN_CHAT_MODEL=qwen-plus
# 规则未命中后的低成本意图分类模型；可独立替换和评测。
QWEN_INTENT_MODEL=qwen-flash
# 低于该置信度一律保守回到企业知识库 RAG。
INTENT_CLASSIFIER_MIN_CONFIDENCE=0.80
QWEN_VISION_MODEL=qwen-vl-plus
QWEN_RERANK_MODEL=qwen3-rerank
QWEN_RERANK_API_URL=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
MODEL_REQUEST_TIMEOUT_SECONDS=60
QWEN_CHAT_MAX_OUTPUT_TOKENS=2048
# 求职分析、简历解析、面试准备等 JSON 任务字段更多，使用独立上限。
QWEN_STRUCTURED_MAX_OUTPUT_TOKENS=4096
AI_MAX_QUESTION_CHARS=2000
AI_MAX_JOB_TEXT_CHARS=30000

# 瞬时错误最多尝试 3 次（包含首次）；指数退避为 0.25s、0.5s。
MODEL_RETRY_MAX_ATTEMPTS=3
MODEL_RETRY_BACKOFF_SECONDS=0.25
MODEL_CIRCUIT_FAILURE_THRESHOLD=5
MODEL_CIRCUIT_RESET_SECONDS=30

# 按当前 DashScope 账号和模型价格填写“元 / 百万 Token”；0 表示只统计 Token、不估算费用。
MODEL_CHAT_INPUT_PRICE_PER_MILLION_YUAN=0
MODEL_CHAT_OUTPUT_PRICE_PER_MILLION_YUAN=0
MODEL_EMBEDDING_PRICE_PER_MILLION_YUAN=0
MODEL_RERANK_PRICE_PER_MILLION_YUAN=0

# 本地直接运行 FastAPI 时使用 127.0.0.1。
# Docker Compose 中会覆盖成 http://qdrant:6333。
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION_NAME=rag_chunks_hybrid_v1
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_SPARSE_VECTOR_NAME=sparse

# RAG 默认参数。
RAG_DEFAULT_TOP_K=3
RAG_DEFAULT_MIN_SCORE=0.55
RAG_DEFAULT_CANDIDATE_K=6
RAG_DEFAULT_SPARSE_LIMIT=6
RAG_DEFAULT_RERANK_TOP_K=3
# true：优先让 Rerank Top K 覆盖不同文档，再按原始分数补满剩余位置。
RAG_RERANK_DOCUMENT_DIVERSITY_ENABLED=true
RAG_DEFAULT_RERANK_MIN_SCORE=0.75
RAG_DEFAULT_FALLBACK_MIN_SCORE=0.55
RAG_SLOW_RERANK_THRESHOLD=3.0

# 日志级别：DEBUG / INFO / WARNING / ERROR。
LOG_LEVEL=INFO

# FastAPI 内部 API Key，用于 Spring Boot → FastAPI 服务间调用。
# Docker Compose 会强制要求非空；请替换为随机长字符串，不要提交真实值。
# 可使用：openssl rand -hex 32
FASTAPI_API_KEY=

# PDF 上传大小上限，单位 MB。
MAX_UPLOAD_SIZE_MB=10

# 岗位截图 / 扫描 PDF 识别时最多读取前几页，避免一次上传超大 PDF 造成模型成本失控。
JOB_OCR_PDF_MAX_PAGES=3

# Spring Boot MySQL 配置。
# 本地 Maven 启动 Spring Boot 时使用 127.0.0.1:3307。
# Docker Compose 启动 backend 容器时会覆盖成 mysql:3306。
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=rag_knowledge_base
MYSQL_HOST_PORT=3307
# Spring Boot 容器映射到宿主机的端口；8080 被占用时可改为 8081。
BACKEND_HOST_PORT=8080
MYSQL_URL=jdbc:mysql://127.0.0.1:3307/rag_knowledge_base?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MYSQL_USER=rag_user
MYSQL_PASSWORD=rag_password

# Redis 保存 AI 接口限流计数、防重复提交锁和后续短期缓存。
# 本地 Maven 启动 Spring Boot 时使用 127.0.0.1:6379。
# Docker Compose 启动 backend 容器时会覆盖成 redis:6379。
REDIS_HOST=127.0.0.1
REDIS_HOST_PORT=6379
REDIS_PORT=6379
REDIS_PASSWORD=

# AI 接口限流：每个用户每分钟、每天最多调用多少次昂贵 AI 接口。
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_PER_MINUTE=5
AI_RATE_LIMIT_PER_DAY=100

# 上传防重复提交锁：防止用户连续点击导致同一 PDF 被重复解析和向量化。
UPLOAD_LOCK_ENABLED=true
UPLOAD_LOCK_TTL_SECONDS=300

# JWT 登录令牌配置。生产环境请换成足够长的随机字符串。
JWT_SECRET=change_me_to_a_long_random_secret_for_jwt_signing
JWT_EXPIRES_IN_SECONDS=86400

# 默认 false：Spring Boot 业务 API 必须携带有效 JWT。
# 只有需要使用旧版 debug.html 通过 userId/department 匿名联调时才临时改为 true。
AUTH_ALLOW_LEGACY_IDENTITY_PARAMETERS=false

# 可选但生产环境强烈建议：简历、JD、聊天正文等敏感字段的 AES-256-GCM 密钥。
# 生成方式：openssl rand -base64 32。密钥丢失后加密数据无法恢复，请使用安全密钥管理服务备份。
SENSITIVE_DATA_ENCRYPTION_KEY=
